# Salin menjadi secrets.toml untuk jalan lokal, atau tempel di Streamlit Cloud -> Settings -> Secrets.
# Isi yang SAMA juga ditempel di Secrets app OSL (osl-invoice-web) supaya tab Rekap Absensi bisa membaca.

absensi_sheet_id = "ID_GOOGLE_SHEET_ABSENSI"   # bagian URL di antara /d/ dan /edit

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
